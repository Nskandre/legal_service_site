# Публичные настройки браузера. Секреты здесь хранить нельзя.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_PAYMENT_URL=

# Доставка заявок в Telegram. Заполняются обе переменные.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Доставка заявок через Resend. Заполняются все три переменные.
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=

# Доставка заявок через SMS.ru. Заполняются обе переменные.
SMSRU_API_ID=
LEAD_SMS_TO=

# Доставка заявок через webhook. URL обязателен, токен необязателен.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=