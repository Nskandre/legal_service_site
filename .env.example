# Публичные настройки браузера. Секреты здесь хранить нельзя.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_MAX_URL=

# Timeweb App Platform / Managed PostgreSQL.
DATABASE_URL=
DATABASE_SSL=true
LEAD_RETENTION_DAYS=

# Доставка заявок в Telegram. Заполняются обе переменные.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Короткие уведомления в MAX.
MAX_BOT_TOKEN=
MAX_CHAT_ID=

# Короткие email-уведомления.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
LEAD_NOTIFICATION_EMAIL=

# Доставка заявок через webhook. URL обязателен, токен необязателен.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=

# Секреты закрытого раздела задаются только через секреты платформы.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
