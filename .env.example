# Публичные настройки браузера. Секреты здесь хранить нельзя.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_MAX_URL=

# Доставка заявок в Telegram. Заполняются обе переменные.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Доставка заявок через webhook. URL обязателен, токен необязателен.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=

# Секреты закрытого раздела задаются только через Cloudflare Workers Secrets.
# ADMIN_PASSWORD и ADMIN_SESSION_SECRET нельзя хранить в этом файле или Git.
