# Публичные настройки браузера. Секреты здесь хранить нельзя.
NEXT_PUBLIC_SITE_URL=https://legservice.ru
NEXT_PUBLIC_YANDEX_METRIKA_ID=113130690
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_MAX_URL=

# Timeweb App Platform / Managed PostgreSQL.
DATABASE_URL=
DATABASE_SSL=true
LEAD_RETENTION_DAYS=

# Доставка заявок в Telegram. Заполняются обе переменные.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Короткие уведомления в MAX.
MAX_BOT_TOKEN=
MAX_CHAT_ID=

# Короткие email-уведомления через транзакционный API DashaMail.
DASHAMAIL_API_KEY=
EMAIL_FROM=site@legservice.ru
EMAIL_FROM_NAME=Сайт legservice.ru
LEAD_NOTIFICATION_EMAIL=legserv24@yandex.ru

# Доставка заявок через webhook. URL обязателен, токен необязателен.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=

# Секреты закрытого раздела задаются только через секреты платформы.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
